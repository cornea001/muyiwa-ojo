# Stripe API Keys
# Find these in your Stripe Dashboard under Developers > API Keys
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# Resend API Key
# Generate this in your Resend Dashboard under API Keys
# Note: muyiwaojo.ca must be a verified domain in Resend for emails to send to external recipients
RESEND_API_KEY=re_...

# Cloudflare (used for DNS/zone management if applicable)
CLOUDFLARE_API_TOKEN=cfut_...
CLOUDFLARE_ZONE_ID=...

# Web Push / VAPID Keys (for push notification support)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:info@muyiwaojo.ca

# Admin Authentication
# Generate a bcrypt hash of your chosen password, e.g.: node -e "const b=require('bcryptjs');b.hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=...
